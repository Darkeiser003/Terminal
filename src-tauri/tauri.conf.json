{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinSlim Terminal",
  "mainBinaryName": "winslim-terminal",
  "identifier": "com.winslim.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WinSlim Terminal",
        "width": 980,
        "height": 640,
        "minWidth": 480,
        "minHeight": 270,
        "maxWidth": 7680,
        "maxHeight": 4320,
        "backgroundColor": "#0d0d0d",
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "resources": {
      "../scripts/containers/docker-manager.sh": "scripts/containers/docker-manager.sh",
      "../scripts/containers/kubernetes-manager.sh": "scripts/containers/kubernetes-manager.sh",
      "../scripts/operations/docker-manager.ps1": "scripts/operations/docker-manager.ps1",
      "../scripts/operations/kubernetes-manager.ps1": "scripts/operations/kubernetes-manager.ps1",
      "../scripts/operations/ssh-manager.sh": "scripts/operations/ssh-manager.sh",
      "../scripts/operations/service-manager.sh": "scripts/operations/service-manager.sh",
      "../scripts/operations/network-manager.sh": "scripts/operations/network-manager.sh",
      "../scripts/operations/adb-manager.sh": "scripts/operations/adb-manager.sh",
      "../scripts/operations/ssh-manager.ps1": "scripts/operations/ssh-manager.ps1",
      "../scripts/operations/service-manager.ps1": "scripts/operations/service-manager.ps1",
      "../scripts/operations/network-manager.ps1": "scripts/operations/network-manager.ps1",
      "../scripts/operations/adb-manager.ps1": "scripts/operations/adb-manager.ps1"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Darkeiser003",
    "category": "DeveloperTool",
    "shortDescription": "Terminal multipestaña y centro local de herramientas",
    "longDescription": "Terminal multipestaña con detección de entornos (cmd, PowerShell, WSL, Docker, ADB), lanzador de scripts, explorador de archivos y hub de proyectos de GitHub.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}
