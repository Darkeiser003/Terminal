; Textos de la plantilla NSIS de Tauri en Romanian: su CLI 2.11.5 no lo trae
; (tauri.windows.installer.conf.json > customLanguageFiles).
LangString addOrReinstall ${LANG_ROMANIAN} "Adaugă/reinstalează componente"
LangString alreadyInstalled ${LANG_ROMANIAN} "Deja instalat"
LangString alreadyInstalledLong ${LANG_ROMANIAN} "${PRODUCTNAME} ${VERSION} este deja instalat. Alege operația dorită și apasă Înainte."
LangString appRunning ${LANG_ROMANIAN} "${PRODUCTNAME} rulează! Închide-l mai întâi și încearcă din nou."
LangString appRunningOkKill ${LANG_ROMANIAN} "${PRODUCTNAME} rulează!$\nApasă OK pentru a-l închide"
LangString chooseMaintenanceOption ${LANG_ROMANIAN} "Alege operația de întreținere."
LangString choowHowToInstall ${LANG_ROMANIAN} "Alege cum vrei să instalezi ${PRODUCTNAME}."
LangString createDesktop ${LANG_ROMANIAN} "Creează o scurtătură pe desktop"
LangString deleteAppData ${LANG_ROMANIAN} "Șterge datele aplicației"
LangString dontUninstall ${LANG_ROMANIAN} "Nu dezinstala"
LangString dontUninstallDowngrade ${LANG_ROMANIAN} "Nu dezinstala (instalarea unei versiuni mai vechi fără dezinstalare este dezactivată în acest program de instalare)"
LangString failedToKillApp ${LANG_ROMANIAN} "${PRODUCTNAME} nu a putut fi închis. Închide-l mai întâi și încearcă din nou"
LangString installingWebview2 ${LANG_ROMANIAN} "Se instalează WebView2..."
LangString newerVersionInstalled ${LANG_ROMANIAN} "O versiune mai nouă de ${PRODUCTNAME} este deja instalată! Nu se recomandă instalarea unei versiuni mai vechi. Dacă vrei totuși, dezinstalează mai întâi versiunea actuală. Alege operația și apasă Înainte."
LangString older ${LANG_ROMANIAN} "mai veche"
LangString olderOrUnknownVersionInstalled ${LANG_ROMANIAN} "Pe sistem este instalată o versiune $R4 de ${PRODUCTNAME}. Se recomandă dezinstalarea versiunii actuale înainte de instalare. Alege operația și apasă Înainte."
LangString silentDowngrades ${LANG_ROMANIAN} "Instalarea unei versiuni mai vechi este dezactivată în acest program; modul silențios nu poate continua, folosește programul de instalare cu interfață grafică.$\n"
LangString unableToUninstall ${LANG_ROMANIAN} "Dezinstalarea nu este posibilă!"
LangString uninstallApp ${LANG_ROMANIAN} "Dezinstalează ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_ROMANIAN} "Dezinstalează înainte de instalare"
LangString unknown ${LANG_ROMANIAN} "necunoscută"
LangString webview2AbortError ${LANG_ROMANIAN} "WebView2 nu a putut fi instalat! Aplicația nu poate rula fără el. Repornește programul de instalare."
LangString webview2DownloadError ${LANG_ROMANIAN} "Eroare: descărcarea WebView2 a eșuat - $0"
LangString webview2DownloadSuccess ${LANG_ROMANIAN} "Programul de pornire WebView2 a fost descărcat"
LangString webview2Downloading ${LANG_ROMANIAN} "Se descarcă programul de pornire WebView2..."
LangString webview2InstallError ${LANG_ROMANIAN} "Eroare: instalarea WebView2 s-a terminat cu codul $1"
LangString webview2InstallSuccess ${LANG_ROMANIAN} "WebView2 a fost instalat"
