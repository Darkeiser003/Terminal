; Textos de la plantilla NSIS de Tauri en Hindi: su CLI 2.11.5 no lo trae
; (tauri.windows.installer.conf.json > customLanguageFiles).
LangString addOrReinstall ${LANG_HINDI} "घटक जोड़ें/फिर से इंस्टॉल करें"
LangString alreadyInstalled ${LANG_HINDI} "पहले से इंस्टॉल है"
LangString alreadyInstalledLong ${LANG_HINDI} "${PRODUCTNAME} ${VERSION} पहले से इंस्टॉल है। जो काम करना है उसे चुनें और आगे बढ़ने के लिए Next दबाएँ।"
LangString appRunning ${LANG_HINDI} "${PRODUCTNAME} चल रहा है! पहले इसे बंद करें और फिर कोशिश करें।"
LangString appRunningOkKill ${LANG_HINDI} "${PRODUCTNAME} चल रहा है!$\nइसे बंद करने के लिए OK दबाएँ"
LangString chooseMaintenanceOption ${LANG_HINDI} "रखरखाव का विकल्प चुनें।"
LangString choowHowToInstall ${LANG_HINDI} "चुनें कि ${PRODUCTNAME} को कैसे इंस्टॉल करना है।"
LangString createDesktop ${LANG_HINDI} "डेस्कटॉप शॉर्टकट बनाएँ"
LangString deleteAppData ${LANG_HINDI} "ऐप्लिकेशन का डेटा हटाएँ"
LangString dontUninstall ${LANG_HINDI} "अनइंस्टॉल न करें"
LangString dontUninstallDowngrade ${LANG_HINDI} "अनइंस्टॉल न करें (इस इंस्टॉलर में बिना अनइंस्टॉल के पुराना संस्करण लगाना बंद है)"
LangString failedToKillApp ${LANG_HINDI} "${PRODUCTNAME} बंद नहीं हो सका। पहले इसे बंद करें और फिर कोशिश करें"
LangString installingWebview2 ${LANG_HINDI} "WebView2 इंस्टॉल हो रहा है..."
LangString newerVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का नया संस्करण पहले से इंस्टॉल है! पुराना संस्करण इंस्टॉल करने की सलाह नहीं दी जाती। अगर सच में चाहिए, तो पहले मौजूदा संस्करण अनइंस्टॉल करें। काम चुनें और Next दबाएँ।"
LangString older ${LANG_HINDI} "पुराना"
LangString olderOrUnknownVersionInstalled ${LANG_HINDI} "आपके सिस्टम पर ${PRODUCTNAME} का $R4 संस्करण इंस्टॉल है। इंस्टॉल करने से पहले मौजूदा संस्करण अनइंस्टॉल करने की सलाह दी जाती है। काम चुनें और Next दबाएँ।"
LangString silentDowngrades ${LANG_HINDI} "इस इंस्टॉलर में पुराना संस्करण लगाना बंद है; साइलेंट इंस्टॉलर आगे नहीं बढ़ सकता, कृपया ग्राफ़िकल इंस्टॉलर का उपयोग करें।$\n"
LangString unableToUninstall ${LANG_HINDI} "अनइंस्टॉल नहीं हो सका!"
LangString uninstallApp ${LANG_HINDI} "${PRODUCTNAME} अनइंस्टॉल करें"
LangString uninstallBeforeInstalling ${LANG_HINDI} "इंस्टॉल करने से पहले अनइंस्टॉल करें"
LangString unknown ${LANG_HINDI} "अज्ञात"
LangString webview2AbortError ${LANG_HINDI} "WebView2 इंस्टॉल नहीं हो सका! इसके बिना ऐप नहीं चल सकता। इंस्टॉलर फिर से चलाएँ।"
LangString webview2DownloadError ${LANG_HINDI} "त्रुटि: WebView2 डाउनलोड विफल - $0"
LangString webview2DownloadSuccess ${LANG_HINDI} "WebView2 बूटस्ट्रैपर डाउनलोड हो गया"
LangString webview2Downloading ${LANG_HINDI} "WebView2 बूटस्ट्रैपर डाउनलोड हो रहा है..."
LangString webview2InstallError ${LANG_HINDI} "त्रुटि: WebView2 इंस्टॉलेशन कोड $1 के साथ विफल हुआ"
LangString webview2InstallSuccess ${LANG_HINDI} "WebView2 इंस्टॉल हो गया"
