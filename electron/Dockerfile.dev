# Dockerfile.dev - entorno de desarrollo para Linux/Mac
#
# NO produce el .exe portable de Windows (node-pty debe compilarse en el SO
# y arquitectura de destino, ver electron/README.md). Sirve para que alguien
# sin Python/Visual Studio Build Tools/toolchain nativo instalado pueda:
#   - correr `npm install` y comprobar que las dependencias resuelven,
#   - ejecutar `node --check` sobre los archivos del proceso principal,
# dentro de un contenedor reproducible, sin tocar su máquina.
FROM node:20-bookworm

# node-pty compila un addon nativo: hacen falta las mismas herramientas de
# compilación que en Windows (Python + toolchain C/C++), aquí vía apt.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

CMD ["bash"]
