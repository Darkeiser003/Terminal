{
  "name": "winslim-terminal",
  "version": "1.4.3",
  "description": "WinSlim Terminal - terminal y hub de proyectos de Darkeiser003",
  "author": "Darkeiser003",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:workspace && npm run metadata:sync",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/build.ps1 -NoRun",
    "dist:linux": "bash linux/build.sh --no-run",
    "e2e:build": "tauri build --debug --no-bundle",
    "e2e": "node tests/e2e/smoke.mjs",
    "test:release": "bash linux/validate-release.sh",
    "test:host": "bash linux/exercise-host.sh",
    "check:version": "node scripts/verify-version.mjs",
    "check:assets": "node scripts/verify-runtime-assets.mjs",
    "check:architecture": "node scripts/verify-architecture.mjs",
    "check:workspace": "node scripts/verify-workspace.mjs",
    "metadata:sync": "node scripts/sync-package-metadata.mjs",
    "check:metadata": "node scripts/sync-package-metadata.mjs --check",
    "check": "npm run check:version && npm run check:assets && npm run check:architecture && npm run check:workspace && npm run check:metadata && svelte-check --tsconfig ./tsconfig.json && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.2.7",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.1.2",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkeiser003/Terminal"
  },
  "bugs": {
    "email": "tebarcascallarromen@gmail.com"
  }
}
